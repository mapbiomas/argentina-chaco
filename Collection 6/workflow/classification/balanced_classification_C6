          to:[ 3, 4, 6, 9, 11, 15, 19, 23, 25, 25, 33, 36, 12, 12, 63, 63, 19, 19, 61], bandName:'classification_'+ year})

    if (app.current_year >= 1985 && app.current_year <= 2023){
          var coleccion5 = coleccion5.rename('classification_'+ year)
                                        //.filter(ee.Filter.eq('version','2'))
