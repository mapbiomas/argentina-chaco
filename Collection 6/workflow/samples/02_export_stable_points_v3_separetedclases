var getTrainingSamples = function (feature) {
  var regiao = ee.Number(feature.get('zona'));

  var thr_altura = ee.Number(umbralesZonas.get(regiao))
  //Se elije la altura deseada y se hace una mascara
  
  var msk_altura = altura.lte(thr_altura)
  //Se hace una mascara para la clase que se quiere dividir
  var vegMask_LC = ee.Image(0)
                         .where(dirsamples
                         .eq(3)
                         ,1)
  //Se unen las mascaras y se cambia la clase
  var vegMap_LC = ee.Image(0)
                 .where(vegMask_LC.eq(1).and(msk_altura.eq(1)), 66)
    
  vegMap_LC = vegMap_LC.updateMask(vegMap_LC.neq(0))
  var dirsamples_clasesNuevas = dirsamples.where(vegMap_LC, vegMap_LC)
  
  var vegMask_LA = ee.Image(0)
                         .where(dirsamples_clasesNuevas
                         .eq(4)
                         ,1)
  //Se unen las mascaras y se cambia la clase
  var vegMap_LA = ee.Image(0)
                 .where(vegMask_LA.eq(1).and(msk_altura.eq(1)), 77)
    
  vegMap_LA = vegMap_LA.updateMask(vegMap_LA.neq(0))
  dirsamples_clasesNuevas = dirsamples_clasesNuevas.where(vegMap_LA, vegMap_LA)
    
  
  
  //print(regiao)
  var num_train_03 = nSamples
  var num_train_04 = nSamples
  var num_train_06 = nSamples
  var num_train_09 = nSamples
  var num_train_11 = nSamples
  var num_train_12 = nSamples
  var num_train_15 = nSamples
  var num_train_19 = nSamples
  var num_train_25 = nSamples
  var num_train_33 = nSamples
  var num_train_36 = nSamples
  var num_train_63 = nSamples
  var num_train_66 = nSamples
  var num_train_77 = nSamples

  var clippedGrid = ee.Feature(feature).geometry()

  var referenceMap =  dirsamples_clasesNuevas.clip(clippedGrid);
  //Map.addLayer(referenceMap,vis)
 // Map.addLayer(msk_altura, {}, 'Msk Altura ' + regiao, false)
                    
  var training = referenceMap.stratifiedSample({scale:30, classBand: 'reference', numPoints: 0, region: feature.geometry(), seed: 1, geometries: true,
           classValues: [3, 4, 6, 9, 11, 12, 15, 19, 25, 33, 36, 63, 66, 77], 
           classPoints: [num_train_03,
                         num_train_04,
                         num_train_06,
                         num_train_09,
                         num_train_11,
                         num_train_12,
                         num_train_15,
                         num_train_19,
                         num_train_25,
                         num_train_33,
                         num_train_36,
                         num_train_63,
                         num_train_66,
                         num_train_77,
                         ]
  });

  training = training.map(function(feat) {return feat.set({'zona': regiao})});
  return training;
 };

var mySamples = regioesCollection.map(getTrainingSamples).flatten();

