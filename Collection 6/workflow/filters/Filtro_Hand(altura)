var doHandClasses = function (dist) {

  var gaussianKernel = ee.Kernel.gaussian(3, 2, 'pixels', true, 2);
  var terrain = ee.call('Terrain', srtm.convolve(gaussianKernel));
  
  var slope = radians(terrain.select(['slope']))
    .lt(lim_slope);//valor original 0.076

  slope = slope
    .focal_max({radius: 50, units: 'meters'})
    .focal_min({radius: 50, units: 'meters'});
  //                                                           varzea = 0                                         proximo a varzea = 15m = 1                                    mais de 15 e encosta = 2                      + 15m e plano = 3      
  var hand_class = hand30_1000.addBands(slope).expression("(b(0) <= "+ lim_class_hand + "  ) ? 0 : (b(0) <= "+ dist +" && b(0) > "+ lim_class_hand + " ) ? 1 : (b(0) > "+ dist +" && b(1) == 0 ) ? 2   : (b(0) > "+ dist +" && b(1) == 1 ) ? 3 : 0" );
  //image.expression('condition ? true_action : false_action)
  return hand_class;
};

