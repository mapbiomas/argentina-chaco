//Este código utiliza una imágen con los años como bandas y elimina los huecos 
//en la clasificación generados por huecos en el mosaico Landsat. Para lograrlo 
//rellena los mismos con la imagen del año anterior y de no ser posible del 
//siguiente inmediato. Luego, el código rellena hacia el año siguiente, si es que 
//quedaron huecos. Ej: Si hay un hueco en 1987 se rellenará con el valor para 
//dicho píxel en 1986 y si también hay hueco con el de 1985, si también hay hueco 
//utiliza el valor de 1988. También agrega la propiedad connected, que cuenta la 
//cantidad de píxeles conectados con la misma clase que tiene cada píxel.
//
//Entrada:
//-image: La ruta del asset donde se encuentra el mosaico de las clasificaciones
//con los años como bandas de una única imagen que tiene todas las zonas.
//-regioesCollection: El asset que tiene las zonas de la región a mapear
//
//Salida:
//Una imagen con los años como bandas sin huecos y la conectividad de cada píxel
//
//Variables a modificar
//-col: entre comillas el número de colección.
//-version: entre comillas la versión de la clasificación.
//-years: los años mapeados en la imagen de input en formato 'AAi-AAf'
//-dirout: Asset donde deseamos guardar la clasificación sin huecos
//se recomienda usar una sola image collection para todos los filtros
//
//Al cambiar de colección es necesario modificar las dos variables de bandNames y la variable 'anos'
//Este script se puede usar también por zona sin hacer modificaciones, utilizando una imagen
//que tenga únicamente la zona que se quiere filtrar y agregando algún indicativo
// de zona en el nombre al exportar

var version = '3'; 
var col = '6'
var years = '1985-2024'
var col_arg = '2'

//NO modificar
// Col 5 v0 sin filtro

var image = ee.Image('projects/mapbiomas-argentina/assets/LAND-COVER/COLLECTION-' + col_arg + '/GENERAL/CLASSIFICATION/PRECLASSIFICATION/CHACO/clasificacion-' + years + '-'+ version + '-sin_filtroARG-mosaic')
print(image, 'image')
var dirout = 'projects/mapbiomas-argentina/assets/LAND-COVER/COLLECTION-' + col_arg + '/GENERAL/CLASSIFICATION/FILTERS/CHACO/clasificaciones-filtradas/'

var regioesCollection = ee.FeatureCollection("projects/mapbiomas-chaco/SENTINEL/Limites/Nuevo_Limite_Operativo")

var versionOut =  'col' + col + '-v' + version + '-gap-' + years + '-mosaic';


var bandNames = ee.List([
