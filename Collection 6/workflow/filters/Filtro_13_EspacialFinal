var regioesCollection = ee.FeatureCollection("projects/mapbiomas-chaco/SENTINEL/Limites/Nuevo_Limite_Operativo")
var bands = img_in.bandNames()

var filtroEspacial = function(band, img){
  var image = img_in.select([band])
  var patches = image.int16().connectedPixelCount(100, false);
  var moda = image.focal_mode(1, 'square', 'pixels')
  moda = moda.updateMask(patches.lte(5))
  
  return ee.Image(img).addBands(image.blend(moda))
}

var output = ee.Image(bands.iterate(filtroEspacial, ee.Image()))
print(output)


