 var moda_vn = function(image_in){
  var lst = image_in.bandNames().map(function(b){return ee.Image(image_in.select([b])).rename("B").toInt16()})
  return ee.ImageCollection.fromImages(lst).mode()
  
}

var moda = moda_vn(image_in)

var exp = '100*((b( 0)+b( 1)+b( 2)+b( 3)+b( 4)+b( 5)+b( 6)+b( 7)+b( 8)+b( 9)'+
               '+b(10)+b(11)+b(12)+b(13)+b(14)+b(15)+b(16)+b(17)+b(18)+b(19)'+
               '+b(20)+b(21)+b(22)+b(23)+b(24)+b(25)+b(26)+b(27)+b(28)+b(29)'+
               '+b(30)+b(31)+b(32)+b(33)+b(34)+b(35)+b(36)+b(37)+b(38)+b(39))/40)';


var freq = function(image_in, moda){
  return image_in.eq(moda).expression(exp)
}


var mask3 = function(valor, ano, imagem){
  var mask = imagem.select('classification_'+ (parseInt(ano) - 1)).neq (valor)
        .and(imagem.select('classification_'+ (ano)              ).eq(valor))
        .and(imagem.select('classification_'+ (parseInt(ano) + 1)).neq (valor))
        .and(freq(imagem, moda).gt(40))
  var muda_img = imagem.select('classification_'+ (ano)    ).mask(mask.eq(1)).where(mask.eq(1), moda);  
  var img_out = imagem.select('classification_' + ano).blend(muda_img)
  return img_out;
}


