// Moda de agricultura/pastura

var moda_agr_pas = function(stack){
  var lst = stack.bandNames().map(function(b){
    var msk = ee.Image(stack.select([b]))
    msk = msk.eq(15).or(msk.eq(19)) // 
    return ee.Image(stack.select([b])).updateMask(msk).rename("B").toInt16()
  })
  return ee.ImageCollection.fromImages(lst).mode()
  
}

//Moda sin agua ni pz inundable
var moda_no_inund = function(stack){
  var lst = stack.bandNames().map(function(b){
    var msk = ee.Image(stack.select([b]))
    msk = msk.neq(11).and(msk.neq(33)) // 
    return ee.Image(stack.select([b])).updateMask(msk).rename("B").toInt16()
  })
  return ee.ImageCollection.fromImages(lst).mode()
  
}

//Moda sin agua ni pz inundable
