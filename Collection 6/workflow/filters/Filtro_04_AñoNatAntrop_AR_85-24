var window5years_1Nat = function(imagem, valor1, valor2, valor3, valor4, valor5, valor6){
   var img_out = imagem.select('classification_1985')
   var img_out = img_out.addBands(imagem.select('classification_1986'))

   for (var i_ano=0;i_ano<anos5.length; i_ano++){  
     var ano = anos5[i_ano];  
     img_out = img_out.addBands(mask5_1Nat(valor1, valor2, valor3, valor4, valor5, valor6, ano, imagem)) }
     img_out = img_out.addBands(imagem.select('classification_2022'))
     img_out = img_out.addBands(imagem.select('classification_2023'))
     img_out = img_out.addBands(imagem.select('classification_2024'))
   return img_out
}

