var mask5_1Nat = function(valor1, valor2, valor3, valor4, valor5, valor6, ano, imagem){
  var mask = imagem.select('classification_'+ (parseInt(ano) - 2)).eq (valor1).or(imagem.select('classification_'+ (parseInt(ano) - 2)).eq(valor2))
        .and((imagem.select('classification_'+ (parseInt(ano) - 1)).eq(valor1).or(imagem.select('classification_'+ (parseInt(ano) - 1)).eq(valor2))))
        .and(imagem.select('classification_'+ (ano)).eq(valor3).or(imagem.select('classification_'+ (parseInt(ano) )).eq(valor4)).or(imagem.select('classification_'+ (parseInt(ano) + 1)).eq(valor5)).or(imagem.select('classification_'+ (parseInt(ano) + 1)).eq(valor6)))
        .and(imagem.select('classification_'+ (parseInt(ano) + 1)).eq(valor1).or(imagem.select('classification_'+ (parseInt(ano) + 1)).eq(valor2)))
        .and(imagem.select('classification_'+ (parseInt(ano) + 2)).eq (valor1).or(imagem.select('classification_'+ (parseInt(ano) + 2)).eq(valor2)))
  var muda_img  = imagem.select('classification_'+ (ano)              ).mask(mask.eq(1)).where(mask.eq(1), valor2);  
  var img_out = imagem.select('classification_'+ano).blend(muda_img)
  return img_out;
}
